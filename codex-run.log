   * most every few hours when the sampler refreshes it.
   */
  private longTermVersion(daily: DailyCandle[] | null) {
    if (this.longTermCache?.source !== daily) {
      this.longTermCache = {
        source: daily,
        version: digest(JSON.stringify(daily)),
      };
    }
    return this.longTermCache.version;
  }
  summary() {
    const {
      candles,
      candlesByTimeframe,
      trades,
      orders,
      riskEvents,
      longTermDaily,
      ...summary
