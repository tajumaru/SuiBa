import { z } from "zod";
import {
  emptyNarrationState,
  emptyWatchKindStats,
  MAX_CHAT_ENTRIES,
  MAX_NARRATION_ENTRIES,
  type NarrationState,
} from "./agentNarration.ts";

const KEY = "suiba.narration.v1";
type StorageAccess = Pick<Storage, "getItem" | "setItem">;
const number = z.number().finite();
const nullableNumber = number.nullable();
const condition = z.enum(["emaUp", "rsiRecovery", "histogramImproving"]);
const trail = z.object({
  evaluatedAt: number,
  price: number,
  ema20: number,
  ema50: number,
  rsi: number,
  histogram: number,
  atr: number,
  oversold: number,
  emaUp: z.boolean(),
  emaGapShrinking: z.boolean(),
  rsiRecovery: z.boolean(),
  histogramImproving: z.boolean(),
  hasPosition: z.boolean(),
  rsiLinePrice: nullableNumber,
});
const schema: z.ZodType<NarrationState> = z.object({
  entries: z
    .array(
      z.object({
        id: z.string(),
        at: number,
        kind: z.enum([
          "cycle",
          "trade",
          "rejection",
          "stop",
          "start",
          "warning",
          "recovery",
          "nearMiss",
          "watchHit",
          "reach",
          "superReach",
          "priceLine",
          "priceLineReached",
          "sellLine",
          "sellLineCrossing",
          "review",
          "alert",
          "sleepTalk",
          "chatUser",
          "chatReply",
          "chatPrompt",
          "epoch",
          "monthlyReport",
          "btc",
          "forecastCall",
          "forecastHit",
          "forecastMiss",
          "forecastTouch",
          "forecastTouchNear",
          "bookWall",
          "forecastCalib",
          "memory",
          "greeting",
          "status",
        ]),
        text: z.string(),
        side: z.enum(["BUY", "SELL"]).optional(),
        topic: z.string().optional(),
        promptChip: z.string().optional(),
        forecastOrigin: number.optional(),
        sellLineSide: z.enum(["tp", "sl"]).optional(),
      }),
    )
    .max(MAX_NARRATION_ENTRIES + MAX_CHAT_ENTRIES),
  nextEntryId: number.int().nonnegative(),
  priceRising: z.boolean(),
  priceHistory: z.array(number),
  alertCooldown: number,
  lastAlert: z
    .object({ at: number, direction: z.enum(["up", "down", "volume"]) })
    .nullable(),
  lastHitAt: nullableNumber,
  lastNearMiss: z
    .object({ key: condition, closestDistance: number })
    .nullable(),
  sleepingSince: nullableNumber,
  lastSleepTalkAt: nullableNumber,
  lastSleepTalkText: z.string().nullable(),
  watch: z
    .object({
      key: condition,
      declaredDistance: number,
      called: z.boolean(),
      closestDistance: number,
    })
    .nullable(),
  // Stored states from before the reach escalation existed parse
  // with the defaults instead of being thrown away.
  reach: z
    .object({ key: condition, stage: z.enum(["reach", "super"]) })
    .nullable()
    .default(null),
  hitStreak: number.default(0),
  priceLine: z
    .object({ price: number, reached: z.boolean(), murmured: z.boolean() })
    .nullable(),
  // Stored states from before the sell lines existed parse with
  // the default instead of being thrown away.
  sellLines: z
    .object({ tp: number, sl: number })
    .nullable()
    .default(null),
  sellLineCrossingState: z
    .record(z.enum(["tp", "sl"]), z.object({
      present: z.boolean(),
      absentSince: nullableNumber,
      lastCalledAt: nullableNumber,
    }))
    .default({
      tp: { present: false, absentSince: null, lastCalledAt: null },
      sl: { present: false, absentSince: null, lastCalledAt: null },
    }),
  watchScore: z.object({
    declared: number,
    hits: number,
    misses: number,
    unreviewed: number,
  }),
  // Stored states from before the per-kind stats existed parse
  // with the default instead of being thrown away.
  watchKindStats: z
    .object({
      emaUp: z.object({ hits: number, misses: number }),
      rsiRecovery: z.object({ hits: number, misses: number }),
      histogramImproving: z.object({ hits: number, misses: number }),
    })
    .default(emptyWatchKindStats()),
  sessionStartPrice: nullableNumber,
  seen: z.array(z.string()).max(200),
  retiredEventThrough: nullableNumber,
  retiredCandidateThrough: nullableNumber,
  pendingCandidateIds: z.array(z.string()).max(50),
  lastDecisionAt: nullableNumber,
  prevDecisionPrice: nullableNumber,
  lastTrail: trail.nullable(),
  prevTrail: trail.nullable(),
  lastConnectivity: z.string().nullable(),
  lastStatus: z.string().nullable(),
  initialized: z.boolean(),
  // Stored states from before the monthly report existed parse
  // with the defaults instead of being thrown away.
  monthly: z
    .record(
      z.string(),
      z.object({
        declared: number,
        hits: number,
        misses: number,
        nearMisses: number,
        stops: number,
        stopReasons: z.record(z.string(), number),
        fillsBuy: number,
        fillsSell: number,
      }),
    )
    .default({}),
  monthlyFinalised: z.string().nullable().default(null),
  lastBtcMutter: z
    .object({ at: number, direction: z.enum(["up", "down"]) })
    .nullable()
    .default(null),
  bookWalls: z
    .array(
      z.object({
        side: z.enum(["bid", "ask"]),
        price: number,
        qty: number,
        multiple: number,
        sinceAt: number,
        announced: z.boolean(),
      }),
    )
    .default([]),
  bookAt: number.nullable().default(null),
  bookAdopted: z.boolean().default(false),
  lastBookEntryAt: number.nullable().default(null),
  bookWallCooldowns: z.record(z.string(), number).default({}),
  forecastDeclared: z.record(z.string(), number).default({}),
  forecastSettled: z.record(z.string(), z.boolean()).default({}),
  forecastTouchSettled: z.record(z.string(), z.boolean()).default({}),
  lastForecastCallAt: number.nullable().default(null),
  lastCalibScoredAt: number.default(0),
  forecastCalibEventIds: z.array(z.string()).default([]),
  memoryCooldowns: z.record(z.string(), number).default({}),
  // The rollout time defaults at restore time, so every entry in a legacy
  // save predates the feature and remains visible. Both inputs are optional
  // for states written before the memory seal existed.
  memorySealEnabledAt: number.default(() => Date.now()),
  openedMemorySealIds: z.array(z.string()).max(200).default([]),
});

// Resolve storage inside the try: browsers may deny even the localStorage getter.
/** Narration is stored per pair: SUI keeps the original key (so
 * existing histories carry over untouched), other pairs get
 * their own key and start fresh — a pair switch must never mix
 * one market's feed, scoreboard or chat memory into another's. */
function keyFor(scope: string): string {
  return scope === "SUI" ? KEY : `${KEY}:${scope}`;
}

export function restoreNarration(
  storage?: StorageAccess,
  scope = "SUI",
): NarrationState {
  try {
    const raw = (storage ?? window.localStorage).getItem(keyFor(scope));
    if (!raw || raw.length > 500_000) return emptyNarrationState();
    const result = schema.safeParse(JSON.parse(raw));
    return result.success ? result.data : emptyNarrationState();
  } catch {
    return emptyNarrationState();
  }
}

export function persistNarration(
  state: NarrationState,
  storage?: StorageAccess,
  scope = "SUI",
): void {
  try {
    (storage ?? window.localStorage).setItem(
      keyFor(scope),
      JSON.stringify(state),
    );
  } catch {
    // Storage restrictions or a full quota must not interrupt live narration.
  }
}
/**
 * The agent narration feed: chat-style entries generated ONLY from
 * records the worker actually stored — operation events, candidate
 * audits, and the validated decision-evidence telemetry in the
 * snapshot. Every number in a text comes from those records; nothing
 * is invented, estimated, or back-filled. When the evidence is missing
 * or malformed the feed stays silent for that cycle (fail-closed),
 * exactly like the vital signs next to it.
 *
 * Cycle narration follows the approved "reasons, softly and shortly"
 * style: one or two short sentences in a companionable tone (never
 * report-style), carrying at least one recorded number, naming the
 * entry condition that is still missing, and — via the previous
 * cycle's DecisionTrail — whether things approached, newly clicked,
 * or fell back since last time.
 *
 * On top of the per-cycle lines, the feed keeps a declared "watch":
 * the one unmet entry condition that looks closest to clicking (by
 * the same normalised distances the narration already uses to pick
 * what to talk about). The watch is announced once when the target
 * changes, gets a single call-out when it closes to half its declared
 * distance, is celebrated — tied back to the declaration — when it
 * clicks, and is honestly withdrawn, with hysteresis so small wobbles
 * cannot flap it, when it drifts clearly further away than declared.
 * A withdrawal after the call-out — it really did come close — is
 * told as a ニアミス (near miss) instead: the closest distance seen
 * while watching is named, and only that line slips into Kansai
 * dialect, the character's disappointment leaking through. A watch
 * that never came close is withdrawn in the plain words, as before.
 * The hit line is its counterpart: the facts stay as recorded, the
 * close turns smug in the same dialect, and the pose flashes the
 * pointing smile while the hit is fresh.
 *
 * Every declaration is also scored: a watch that clicks while it is
 * being watched is a 的中 (hit), one withdrawn for drifting away is
 * an 外れ (miss), and a watch that ends silently (a position opened,
 * the material went away) is neither. Once enough settlements have
 * piled up since the last look-back — or a BUY closes a chapter with
 * at least a couple waiting — the feed pauses for a short ふりかえり
 * (review) built only from those recorded counts and the session's
 * first-to-current price move.
 *
 * While the bot sleeps (a plain stop, never a safety stop), the
 * character occasionally talks in its sleep: at most one mutter
 * per quarter hour, built only from the session's recorded facts
 * (a near miss, a told hit, a recorded buy), never the same one
 * twice in a row, with a fact-free dream of 基軸通貨 itself as the
 * fallback when the session left nothing to dream about.
 *
 * The feed also keeps a short history of the narrated cycles'
 * decision prices, so a sudden market move — the price jumping at
 * least ±1% against three cycles ago, or the recorded volume change
 * spiking past +200% — can break in as a 速報 (alert). An alert is
 * market news, not a trading judgement: it never replaces the
 * cycle's own line, it stays silent until the price history has
 * warmed up, and after one fires the next is held back for five
 * narrated cycles so a continuing move is not re-announced.
 *
 * All functions here are pure: the component keeps a NarrationState,
 * feeds each new snapshot through `advanceNarration`, and renders the
 * accumulated entries. `agentPose` derives the character's pose from
 * the same state, so pose and text can never disagree.
 */

/* Split into per-area modules under ./narration/ (state, format,
   decision, watch, alerts, advance, pose). This file is only the
   public surface: it re-exports exactly what the former single
   module exported, so import sites are unchanged. */
export type { AgentPose, NarrationKind, NarrationEntry, WatchTarget, ReachState, WatchScore, WatchKindStat, WatchKindStats, SpikeAlertDirection, NarrationState, DecisionTrail, ConditionChipTone, EntryConditionChip, WatchDisplay, WatchScoreDisplay, SpikeAlert } from "./narration/state.ts";
export { MAX_NARRATION_ENTRIES, MAX_CHAT_ENTRIES, trimNarrationEntries, DECISION_FRESH_MS, emptyNarrationState, emptyWatchKindStats } from "./narration/state.ts";
export { decisionTrail, metEntryConditions, cycleNarrationText, sellLinesOf } from "./narration/decision.ts";
export { WATCH_APPROACH_RATIO, WATCH_WITHDRAW_RATIO, WATCH_NAME, WATCH_KIND_ORDER, REVIEW_SETTLED_THRESHOLD, REVIEW_BUY_MIN_SETTLED, SPECIALTY_MIN_JUDGED, entryConditionChips, currentConditionChips, currentWatch, currentWatchScore, hitStreakText, processReach, reachText, recordWatchKind, reviewNarrationTexts, specialtyOf, superReachText } from "./narration/watch.ts";
export { ALERT_PRICE_LOOKBACK, ALERT_PRICE_THRESHOLD, ALERT_VOLUME_THRESHOLD, ALERT_COOLDOWN_CYCLES, spikeAlert } from "./narration/alerts.ts";
export { FORECAST_CALL_COOLDOWN_MS, FORECAST_CALL_FRESH_MS, FORECAST_VERDICT_FRESH_MS, PRICE_LINE_MURMUR_PCT, SLEEP_TALK_INTERVAL_MS, advanceNarration, btcMutter } from "./narration/advance.ts";
export { BOOK_ENTRY_MIN_INTERVAL_MS, BOOK_WALL_COOLDOWN_MS, WALL_MIN_MULTIPLE, WALL_NEAR_PCT, advanceBookWalls, detectBookWalls, type BookWall, type BookWallState } from "./narration/book.ts";
export { forecastReasonText } from "./narration/forecast-reason.ts";
export { agentPose, agentPoseDetails, BUY_CELEBRATION_MS, CELEBRATION_FRESH_MS, isBuyTradeEntry, findNewBuyEntry, buyCelebrationActive, type PointSmileCause } from "./narration/pose.ts";
import type { DecisionTelemetry } from "../../../worker/src/operations.ts";
export type AgentPose =
  | "normal"
  | "point"
  | "pointSmile"
  | "sleep"
  | "laptop"
  | "buyLine";

export type NarrationKind =
  | "cycle" // a strategy analysis cycle (WAIT / signal / position watch)
  | "trade" // a PAPER fill was recorded
  | "rejection" // a signal fired but a gate turned it down
  | "warning" // API failure, anomaly, degraded connectivity
  | "stop" // the bot stopped (manual or safety)
  | "start" // the bot started
  | "recovery" // connectivity recovered / run resumed
  | "review" // a ふりかえり look-back over the watch score so far
  | "nearMiss" // a called watch withdrawn — it came close, then slipped away
  | "watchHit" // a declared watch clicked — the smug counterpart of a near miss
  | "reach" // a リーチ call: two of three buy conditions met, once per episode
  | "superReach" // the reach escalated: the last condition closed to the approach distance
  | "priceLine" // the buy-run line declared — RSI's target price, called out loud
  | "priceLineReached" // the price touched the declared buy-run line
  | "sellLine" // the sell lines declared — take-profit / stop-loss prices of the open position
  | "sellLineCrossing" // a forecast path newly meets an open position's sell line
  | "sleepTalk" // a mutter from the sleeping character, built from recorded facts
  | "alert" // a 速報 breaking in on a sudden price / volume move
  | "chatUser" // a comment the user typed to the character
  | "chatReply" // the character's record-grounded reply (agentChat.ts)
  | "chatPrompt" // the character speaking up at a milestone, with a suggested question
  | "epoch" // a new Sui epoch began (the chain's own daily milestone)
  | "monthlyReport" // the finished month's report card, posted once
  | "btc" // market weather: BTC moved an hour's worth, worth a mutter
  | "forecastCall" // a direction-claiming chart forecast, declared out loud
  | "forecastHit" // a declared forecast whose direction came true
  | "forecastMiss" // a declared forecast whose direction did not
  | "forecastTouch" // a declared forecast's touch line was reached
  | "forecastTouchNear" // the touch line was nearly reached before time ran out
  | "bookWall" // an order-book wall appeared / vanished / was breached
  | "forecastCalib" // the cone's width learned from its scored record
  | "memory" // a display-only historical situation statistic, optionally with recall
  | "greeting" // the incoming character's handover line on a character switch
  | "status"; // feed-initialised status line

export interface NarrationEntry {
  id: string;
  at: number;
  kind: NarrationKind;
  text: string;
  /** Fill side, recorded only on trade entries (from the candidate
   * audit's finalAction). Lets the display tell a buy fill from a
   * sell fill without re-reading the wording. */
  side?: "BUY" | "SELL";
  /** Chat topic, recorded only on chatReply entries (agentChat's
   * ChatTopic as a plain string, to keep the modules decoupled):
   * the conversation memory the next reply reads. */
  topic?: string;
  /** A slash-command reply: rendered as a monospace readout
   * with a CMD tag, and never spoken aloud. */
  mono?: boolean;
  /** The suggested question on a chatPrompt entry, rendered as a
   * tappable chip inside the entry. */
  promptChip?: string;
  /** The forecast's origin (candle timestamp, seconds),
   * recorded only on forecast declaration and verdict entries
   * (forecastCall / forecastHit / forecastMiss): the identity
   * of the one forecast the entry speaks of, so a verdict can
   * be paired with the exact declaration that promised it —
   * several forecasts can be outstanding at once, so unlike
   * the serial watches their pairing cannot be recovered
   * reliably from the texts alone. */
  forecastOrigin?: number;
  sellLineSide?: "tp" | "sl";
}

/**
 * The declared watch: one unmet entry condition the narration has
 * announced it is keeping an eye on. `declaredDistance` is the
 * empirical distance (see watchDistance) at declaration time and is
 * the baseline for the approach call-out and the withdrawal
 * hysteresis; `called` makes the call-out once per declaration.
 * `closestDistance` is the smallest distance seen while watching —
 * the near-miss line names it when a called watch slips away.
 */
export interface WatchTarget {
  key: "emaUp" | "rsiRecovery" | "histogramImproving";
  declaredDistance: number;
  called: boolean;
  closestDistance: number;
}

/**
 * The reach escalation of the current two-of-three episode: the
 * stretch of cycles where exactly two buy conditions stand met
 * and one — `key` — is still missing. `stage` is "reach" once the
 * episode has been called, "super" once the escalation (the last
 * condition closing to the watch's approach distance) has been
 * called too. Each stage is told at most once per episode; the
 * episode ends silently when the count leaves two, or the missing
 * condition changes.
 */
export interface ReachState {
  key: EntryCondKey;
  stage: "reach" | "super";
}

/**
 * The session score of declared watches. `declared` counts every
 * watch ever declared this session (a switch target is a new
 * declaration of its own; the silent first watch counts too, as in
 * the approved prototype). `hits` / `misses` count settled watches:
 * a hit is a watched condition that clicked while watched —
 * including clicking as the last condition into a BUY — and a miss
 * is a watch withdrawn by the drift hysteresis. A watch that ends
 * silently is neither. `unreviewed` counts settlements since the
 * last review entry; it drives the review milestone and resets when
 * a review is told, while the other counters are cumulative.
 */
export interface WatchScore {
  declared: number;
  hits: number;
  misses: number;
  unreviewed: number;
}

/** Settlements split by the watched condition (the character's
 * per-kind record — the material for its 得意技）. Counted only at
 * the same moments the session score settles a watch, so the two
 * can never disagree; a watch that ends silently counts in
 * neither, exactly as in WatchScore. */
export interface WatchKindStat {
  hits: number;
  misses: number;
}
export type WatchKindStats = Record<EntryCondKey, WatchKindStat>;

export function emptyWatchKindStats(): WatchKindStats {
  return {
    emaUp: { hits: 0, misses: 0 },
    rsiRecovery: { hits: 0, misses: 0 },
    histogramImproving: { hits: 0, misses: 0 },
  };
}

/** Which way a spike alert jumped; "volume" is a volume-only spike. */
export type SpikeAlertDirection = "up" | "down" | "volume";

export interface NarrationState {
  entries: NarrationEntry[];
  nextEntryId: number;
  priceRising: boolean;
  /** Decision prices of recent narrated cycles (oldest first,
   * capped), the look-back the spike alerts compare against. Seeded
   * by the feed's first recorded decision. */
  priceHistory: number[];
  /** Narrated cycles still silenced after the last spike alert. */
  alertCooldown: number;
  /** The newest spike alert, for pose linkage: the character points
   * on the very cycle an upward alert fired, and never celebrates a
   * downward one. */
  lastAlert: { at: number; direction: SpikeAlertDirection } | null;
  /** When a watch hit was last TOLD (the smug line), for pose
   * linkage: the character flashes its pointing smile while the
   * hit is fresh. Silent settlements (a hit inside a BUY) do not
   * set this — the trade celebration covers those. */
  lastHitAt: number | null;
  /** The most recent TOLD near miss (key + closest distance), the
   * sleep talk's favourite material. */
  lastNearMiss: { key: EntryCondKey; closestDistance: number } | null;
  /** When the current sleep began (first advance seen sleeping),
   * and the sleep talk's cadence state: the last mutter's time and
   * text, so the same mutter never repeats back to back. All three
   * reset when the bot wakes. */
  sleepingSince: number | null;
  lastSleepTalkAt: number | null;
  lastSleepTalkText: string | null;
  /** The declared watch target, or null when nothing is watched. */
  watch: WatchTarget | null;
  /** The reach escalation of the current two-of-three episode,
   * or null while no episode runs (see ReachState). */
  reach: ReachState | null;
  /** Consecutive TOLD watch hits with no miss settlement in
   * between: the 連チャン count. A told hit grows it (the hit
   * line carries it from the second on), any miss settlement
   * clears it; silent settlements move it neither way. */
  hitStreak: number;
  /** The declared buy-run line, or null: the RSI target price the
   * feed called out, whether the price has touched it yet, and
   * whether the one approaching murmur has already been told. */
  priceLine: { price: number; reached: boolean; murmured: boolean } | null;
  /** The open position's sell lines, or null: the take-profit and
   * stop-loss prices derived from the recorded entry price and the
   * strategy's percentages, declared once per position. */
  sellLines: { tp: number; sl: number } | null;
  sellLineCrossingState: Record<"tp" | "sl", {
    present: boolean;
    absentSince: number | null;
    lastCalledAt: number | null;
  }>;
  /** Cumulative session score of declared watches (see WatchScore). */
  watchScore: WatchScore;
  /** The same settlements split by watched condition (see
   * WatchKindStats). */
  watchKindStats: WatchKindStats;
  /** Price of the first decision evidence this session received. */
  sessionStartPrice: number | null;
  /** Dedupe keys for operation events (`e:...`) and candidates (`c:...`). */
  seen: string[];
  /** Retirement barriers advance only when keys are evicted. Late records at
   * or before retired times are omitted, while recent same-time arrivals work. */
  retiredEventThrough: number | null;
  retiredCandidateThrough: number | null;
  /** Permit an observed PENDING candidate to finish behind the barrier. */
  pendingCandidateIds: string[];
  /** evaluatedAt of the newest decision already accounted for. */
  lastDecisionAt: number | null;
  /** Price of the previous narrated cycle, for grounded price-move text. */
  prevDecisionPrice: number | null;
  /** Narratable facts of the newest decision accounted for. */
  lastTrail: DecisionTrail | null;
  /** The decision before that, for approach / retreat narration. */
  prevTrail: DecisionTrail | null;
  lastConnectivity: string | null;
  lastStatus: string | null;
  initialized: boolean;
  /** Per-month tallies (JST month keys "YYYY-MM") counted at the
   * same authoritative moments as the watch score and the stop /
   * trade drafts, so a finished month can be reported exactly.
   * Counting started when the monthly report shipped — earlier
   * months simply have no counters. */
  monthly: Record<string, MonthlyCounters>;
  /** The newest month key a monthlyReport entry was posted for,
   * so the finalisation fires exactly once per month. */
  monthlyFinalised: string | null;
  /** The last BTC weather mutter told, for its per-direction
   * cooldown. Ambience bookkeeping only. */
  lastBtcMutter: { at: number; direction: "up" | "down" } | null;
  /** Order-book walls currently tracked by the wall watch
   * (narration/book.ts). Ambience bookkeeping only. */
  bookWalls: import("./book.ts").BookWall[];
  /** The `at` of the last book snapshot the wall watch
   * processed. */
  bookAt: number | null;
  /** Whether the wall watch has silently adopted the walls
   * that were standing when the feed opened. */
  bookAdopted: boolean;
  /** The last book entry told, for the wall watch's spacing. */
  lastBookEntryAt: number | null;
  /** Per-level re-appearance cooldowns of the wall watch. */
  bookWallCooldowns: Record<string, number>;
  /** Chart forecasts the feed has declared out loud, by origin
   * (seconds, as a string key) → when the declaration was told.
   * Only direction-claiming forecasts are ever declared; the
   * record is what entitles a forecast to a verdict entry when
   * its horizon closes. */
  forecastDeclared: Record<string, number>;
  /** Declared forecasts whose verdict has been settled — told
   * (hit or miss) or quietly closed when it came too late to
   * tell. By origin, like forecastDeclared. */
