# Testnet TradeCap execution profile (signing enabled). Do not combine with the PAPER env.
MODE=REAL_TRADECAP
REAL_DATABASE_PATH=data/real-tradecap-testnet.sqlite
REAL_NETWORK=testnet
REAL_BALANCE_MANAGER_ID=0x<64-lowercase-hex>
REAL_TRADE_CAP_ID=0x<64-lowercase-hex>
REAL_SIGNER_ADDRESS=0x<64-lowercase-hex>
REAL_SESSION_ID=phase1-local
REAL_POOL_KEY=SUI_DBUSDC
REAL_DEEPBOOK_INDEXER_URL=https://deepbook-indexer.testnet.mystenlabs.com
REAL_SUI_GRAPHQL_URL=https://graphql.testnet.sui.io/graphql
REAL_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Phase 1 test placeholders only; these do not decide design §11 #1 or #3.
REAL_MAX_ORDER_DBUSDC=0.1
REAL_ORDER_TYPE=IOC_LIMIT
REAL_SIGNING_ENABLED=true
# Bot-only key. Never reuse the owner's setup/recovery key.
REAL_BOT_PRIVATE_KEY=
# Standalone testnet swap CLI (dry-run unless --execute).
REAL_SWAP_AMOUNT_SUI=1
REAL_SWAP_MAX_SUI=10
REAL_SWAP_SLIPPAGE_BPS=50
REAL_SWAP_EVIDENCE_PATH=data/real-swap-evidence.jsonl
REAL_PHASE1_EVIDENCE_PATH=data/real-phase1-evidence.json
