{
  "name": "sui-ai-trading-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "tsx apps/worker/src/index.ts",
    "dashboard": "vite apps/dashboard --host 127.0.0.1",
    "build": "tsc --noEmit && vite build apps/dashboard",
    "test": "vitest run",
    "backtest": "tsx apps/worker/src/backtest.ts",
    "smoke": "tsx apps/worker/src/smoke.ts",
    "verify:runtime": "tsx apps/worker/src/verify-runtime.ts",
    "format": "prettier --write apps packages tests README.md tsconfig.json package.json docker pnpm-workspace.yaml"
  },
  "dependencies": {
    "@cetusprotocol/aggregator-sdk": "1.7.5",
    "@mysten/sui": "2.37.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
