      work.priceLine = { ...work.priceLine, price: line };
      if (!work.priceLine.reached && dec.price <= line) {
        work.priceLine = { ...work.priceLine, reached: true };
        work.drafts.push({
          at: dec.evaluatedAt,
          kind: "priceLineReached",
          text: `届いた！${price(line)}タッチ。あとはRSIの反発待ち`,
        });
