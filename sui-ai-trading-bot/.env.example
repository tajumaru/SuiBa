MODE=PAPER
ADMIN_TOKEN=
# Optional GET-only bearer for read-only API clients. Leave unset to disable.
# SUIBA_READONLY_TOKEN=
PORT=3100
DATABASE_PATH=data/bot.sqlite
# VPS/release startup: use 1 after initial DB provisioning; refuse missing selected DB.
REQUIRE_EXISTING_DATABASE=0
# Optional startup override: SUI_USDC or WAL_USDC. Leave unset to restore the UI selection.
# TRADING_PAIR=SUI_USDC
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
# Optional read-only public address
READ_ONLY_ADDRESS=
# Native SUI/Native USDC pool; leave blank for automatic discovery
MARKET_POOL=

# geckoterminal (default), deepbook (strict), auto (DeepBook then whole-series fallback)
MARKET_DATA_PROVIDER=geckoterminal

# off (default) or verified: opt-in reconstruction with official Indexer evidence
DEEPBOOK_RECONSTRUCT_CANDLES=off

# AI shadow: OpenAI gpt-5.4-nano; release stays OFF until owner enables it.
# OFF performs no snapshot freeze, invocation or shadow record append.
SUIBA_SHADOW_ENABLED=false
# Supply the provider credential only through host environment; never commit it.
# SUIBA_SHADOW_API_KEY=
