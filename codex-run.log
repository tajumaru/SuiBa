      dirname(lock.root),
      basename(lock.root),
    );
    assertInitializedPaperState(
      dirname(lock.root),
      basename(lock.root),
      inventory,
    );
    const sources = [...inventory].map((name) => ({
      path: join(dirname(lock.root), name),
