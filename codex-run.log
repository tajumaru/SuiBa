import { backup, DatabaseSync } from "node:sqlite";
import { createHash } from "node:crypto";
import {
  copyFileSync,
  lstatSync,
  mkdirSync,
  readFileSync,
  readdirSync,
  writeFileSync,
  chmodSync,
  openSync,
  readSync,
  closeSync,
  fsyncSync,
  constants,
} from "node:fs";
import { basename, dirname, join, resolve, sep } from "node:path";
import { acquireInstanceLock } from "./deployment-safety.ts";
import {
  assertPaperDatabaseSet,
  assertInitializedPaperState,
  existingPaperDatabases,
  paperDatabaseSuffixes as suffixes,
  requireRegularDatabase as regular,
} from "./paper-database-inventory.ts";
type Entry = {
  name: string;
  sha256: string;
  schemaSha256: string;
  userVersion: number;
};
type Manifest = {
  version: 1;
  mode: "PAPER";
  at: string;
  bootId: string;
  rootName: string;
  databases: Entry[];
};
const digest = (value: Buffer | string) =>
  createHash("sha256").update(value).digest("hex");
function fileDigest(path: string) {
  const hash = createHash("sha256"),
    buffer = Buffer.alloc(1024 * 1024);
  const fd = openSync(path, "r");
  try {
    let size: number;
    while ((size = readSync(fd, buffer, 0, buffer.length, null)) > 0)
      hash.update(buffer.subarray(0, size));
    return hash.digest("hex");
  } finally {
    closeSync(fd);
  }
}

function inspect(path: string, trading = false) {
  regular(path);
  const db = new DatabaseSync(path, { readOnly: true });
  try {
    const checks = db.prepare("PRAGMA integrity_check").all();
    if (checks.length !== 1 || checks[0].integrity_check !== "ok")
      throw Error("BACKUP_INTEGRITY_FAILED");
    if (db.prepare("PRAGMA foreign_key_check").all().length)
      throw Error("BACKUP_FOREIGN_KEY_FAILED");
    if (trading) {
      const row = db
        .prepare("SELECT json FROM bot_runtime_state WHERE key='runtime'")
        .get();
      if (!row || JSON.parse(String(row.json)).running !== false)
        throw Error("BACKUP_REQUIRES_STOPPED_RUNTIME");
    }
    const schema = db
      .prepare(
        "SELECT type,name,tbl_name,sql FROM sqlite_schema WHERE name NOT LIKE 'sqlite_%' ORDER BY type,name",
      )
      .all();
    const version = db.prepare("PRAGMA user_version").get()!;
    return {
      schemaSha256: digest(JSON.stringify(schema)),
      userVersion: Number(version.user_version),
    };
  } finally {
    db.close();
  }
}

/** Local, plaintext staging only. Off-host encryption and retention are a
