      work.sellLines = lines;
      work.drafts.push({
        at: dec.evaluatedAt,
        kind: "sellLine",
        text: `売りラインを引くよ。利確は${price(lines.tp)}、損切りは${price(lines.sl)}。どっちかに届いたら売る`,
