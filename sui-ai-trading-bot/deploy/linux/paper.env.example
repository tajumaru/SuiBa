# Root-owned /etc/suiba/paper.env. No tokens/keys; values are not shell commands.
# Fixed PAPER/loopback/DB/token path values are enforced by start-paper.sh.
MARKET_DATA_PROVIDER=deepbook
DEEPBOOK_RECONSTRUCT_CANDLES=off
# Set the approved read-only Sui gRPC endpoint during host setup.
# SUI_GRPC_URL=https://your-approved-read-only-endpoint
